{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HACO Stability Engine Report 1.0-RC3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "run",
    "object_of_measurement",
    "data",
    "transformations",
    "measurement",
    "policy",
    "decision",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-RC3"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "HACO Coordinate-Frame Stability Audit"
        },
        "version": {
          "const": "1.0-RC3"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "timestamp_utc",
        "engine_version",
        "seeds",
        "runtime_versions"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "engine_version": {
          "const": "1.0.0rc3"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "runtime_versions": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "object_of_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "estimator",
        "notes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "learning-procedure",
            "model",
            "system"
          ]
        },
        "estimator": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets",
        "dataset_fingerprints",
        "split_strategy",
        "preprocessing"
      ],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "dataset_fingerprints": {
          "type": "object",
          "required": [
            "effective_X_y_sha256"
          ],
          "properties": {
            "effective_X_y_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "split_strategy": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "count",
        "strata_count",
        "total_transform_evaluations",
        "audit_status",
        "max_orthogonality_error",
        "min_determinant"
      ],
      "properties": {
        "family": {
          "const": "proper orthogonal rotations"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "strata_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_transform_evaluations": {
          "type": "integer",
          "minimum": 1
        },
        "audit_status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL"
          ]
        },
        "max_orthogonality_error": {
          "type": "number",
          "minimum": 0
        },
        "min_determinant": {
          "type": "number"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "max_pfr",
        "mean_pfr",
        "median_pfr",
        "nonzero_transformations",
        "detection_rate",
        "positive_folds",
        "total_folds",
        "transformation_count",
        "accuracy_identity_mean",
        "accuracy_rotated_min",
        "accuracy_rotated_max",
        "raw_artifact"
      ],
      "properties": {
        "endpoint": {
          "const": "prediction_flip_rate"
        },
        "max_pfr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_pfr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "median_pfr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nonzero_transformations": {
          "type": "integer",
          "minimum": 0
        },
        "detection_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positive_folds": {
          "type": "integer",
          "minimum": 0
        },
        "total_folds": {
          "type": "integer",
          "minimum": 1
        },
        "transformation_count": {
          "type": "integer",
          "minimum": 1
        },
        "accuracy_identity_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy_rotated_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy_rotated_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_relation",
        "max_pfr_tolerance",
        "min_pfr_expected",
        "min_detection_rate",
        "min_positive_folds",
        "notes"
      ],
      "properties": {
        "expected_relation": {
          "enum": [
            "invariant",
            "sensitive",
            "informational"
          ]
        },
        "max_pfr_tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "min_pfr_expected": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "min_detection_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "min_positive_folds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNSCOPED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_sha256",
        "artifact_sha256",
        "config_sha256",
        "factory_sha256"
      ],
      "properties": {
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "factory_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}